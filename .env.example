# Copy this to .env and fill with your Firebase web app keys
# Firebase Console -> Project Settings -> General -> Your apps -> Web app -> Config

VITE_FIREBASE_API_KEY=paste-your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# How to get these in 3 mins:
# 1. Go to https://console.firebase.google.com -> Add project "ironflex-gym"
# 2. Build -> Authentication -> Sign-in method -> Enable Email/Password + Google
# 3. Build -> Firestore Database -> Create database -> Start in test mode
# 4. Project Settings -> Add Web App -> copy config values here
# 5. Restart: npm run dev
# Without this file, app runs in DEMO login mode (works, data stays in browser).
